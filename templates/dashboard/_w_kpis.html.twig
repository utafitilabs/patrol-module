{# Widget "kpis" — the KPI strip (PL·01–04). Rendered by BOTH the dashboard and
   the widget library, so the library's preview IS the widget. #}
<div class="grid g4 patrol-flush">
    <div class="c" data-kpi="month">
        <span class="tab">Patrols<span class="src">· this month</span></span>
        <div class="kpi">
            <b>{{ dashboard.monthCount|number_format }}</b>
            <span>{% for key, type in types %}{{ dashboard.monthTypeCounts[key]|default(0) }} {{ type.label|lower }}{% if not loop.last %} · {% endif %}{% endfor %}</span>
        </div>
    </div>
    <div class="c" data-kpi="distance">
        <span class="tab">Distance<span class="src">· tracks</span></span>
        <div class="kpi hot">
            <b>{{ dashboard.monthDistanceKm|number_format }}<em>km</em></b>
            <span>this month · from GPX</span>
        </div>
    </div>
    {# PL·03 — the share of the area within 2 km of a track recorded this month,
       as the worker filed it on the facts ledger (the month's stored corridors,
       unioned and clipped to the boundary), stated as the design's whole
       percent, with the time it is true as of on the caption line. A fact with
       no value is the em dash, not 0 %: an area with no boundary, or a month
       whose patrols were all hand-logged, has nothing to measure. No fact at
       all is the worker not having run yet, and the caption says so. #}
    {% set coverage = dashboard.coverage %}
    <div class="c" data-kpi="coverage">
        <span class="tab">Coverage<span class="src">· 2 km buffer</span></span>
        <div class="kpi">
            {% if coverage and coverage.known %}
                <b>{{ coverage.value|round }}<em>%</em></b>
            {% else %}
                <b>—</b>
            {% endif %}
            <span>of area within 2 km of a track{{ include('@UhifadhiPatrol/_as_of.html.twig', {fact: coverage}, with_context = false) }}</span>
        </div>
    </div>
    <div class="c" data-kpi="last">
        <span class="tab">Last patrol<span class="src">· live</span></span>
        <div class="kpi">
            {% set last = dashboard.lastPatrol %}
            {% if last and last.startedAt %}
                <b>{{ ((now.timestamp - last.startedAt.timestamp) / 3600)|round(0, 'floor') }}<em>h ago</em></b>
                <span>{{ last.ref }} · {{ last.station ?: '—' }} · {{ types[last.type].label|default(last.type)|lower }}</span>
            {% else %}
                <b>—</b>
                <span>no patrols recorded yet</span>
            {% endif %}
        </div>
    </div>
</div>