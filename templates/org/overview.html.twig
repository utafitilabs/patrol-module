{# THE ORGANIZATION'S PATROLS, AT A GLANCE — the Overview of the three.

   THE STRIP IS THE AREAS' OWN FACTS, ADDED, over every area in scope that runs
   the module; attention is the banner above it. The other two tabs hold the
   tables, so this page holds none. #}
{% extends '@UhifadhiPatrol/org/base.html.twig' %}

{% block title %}Patrols · {{ scope.label }}{% endblock %}

{% block shell_page_subtitle %}Every patrol in every area &mdash; planned, out, and finished &mdash; {% if scope.isOrganization %}at organization scope{% else %}in <b>{{ scope.label }}</b>{% endif %}.{% endblock %}

{% block patrol_org_page %}
    {{ include('@UhifadhiPatrol/org/_banner.html.twig', {silent: silent, door: {label: 'Patrols', href: path(constant('Uhifadhi\\Patrol\\Controller\\PatrolOrgController::PATROLS_ROUTE'))}}, with_context: false) }}

    <div class="factband">
        <span class="f"><span class="k">Areas</span><span class="v">{{ facts.areas }}<em>{{ facts.reporting == facts.areas ? 'all reporting' : facts.reporting ~ ' reporting' }}</em></span></span>
        <span class="f"><span class="k">Out now</span><span class="v">{{ facts.outNow }}<em>across {{ facts.outAreas }} {{ facts.outAreas == 1 ? 'area' : 'areas' }}</em></span></span>
        <span class="f"><span class="k">Finished today</span><span class="v">{{ facts.finishedToday }}<em>this week {{ facts.thisWeek }}</em></span></span>
        <span class="f"><span class="k">Distance this week</span><span class="v">{% if facts.weekDistanceKm is null %}&mdash;<em>nothing measured</em>{% else %}{{ facts.weekDistanceKm|number_format(0) }}<em>km</em>{% endif %}</span></span>
        <span class="sp"></span>
        <span class="more">Settings are the area&rsquo;s</span>
    </div>

    <div class="c">
        <span class="tab">The organization-level patrols<span class="src">&middot; three tabs</span></span>
        <div class="rln"><span>Same tabs as the area module</span><span class="mono d">Overview &middot; Patrols &middot; Patrol types &mdash; every one of them read across all areas</span></div>
        <div class="rln"><span>The area on every row</span><span class="mono d">a fact beside the reference, in the swatch every page gives that area</span></div>
        <div class="rln"><span>Where a type is edited</span><span class="mono d">in the area, by whoever may manage its patrol types &mdash; the Patrol types tab reads across areas and never writes</span></div>
    </div>
{% endblock %}
