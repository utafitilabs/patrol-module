{# One patrol (settled design: the patrols module, main-screen direction
   "detail"): one record grid — the track plate with the observations logged en
   route stacked under it, and the meta + history column beside them.

   View-only — the design carries no edit controls here. Every
   binding comes from the Patrol/Observation entities and the deployment's
   patrol.types / patrol.observation_categories vocabulary, never from code. #}
{% extends '@UhifadhiPatrol/base.html.twig' %}

{% import '@UhifadhiPatrol/_ui.html.twig' as ui %}

{% set typeLabel = types[patrol.type].label|default(patrol.type) %}
{# The ranger's own name for the patrol where they gave one, else the station,
   else the type — Patrol::getDisplayName() decides the first two, and the type
   is the last resort every screen already used. #}
{% set patrolTitle = patrol.displayName ?: typeLabel %}

{% block title %}Patrol {{ patrol.ref }} — {{ patrolTitle }}{% endblock %}

{% block patrol_trail_tail %} <a href="{{ path('patrol_dashboard', {uuid: area.uuid}) }}">patrols</a> / {{ patrol.ref|lower }}{% endblock %}

{% block shell_page_title %}Patrol {{ patrol.ref }} — {{ patrolTitle }}{% if patrol.discarded %} <span class="chip patrol-discard-pill">discarded</span>{% endif %}{% endblock %}

{# The design's subtitle, assembled from what this patrol actually knows — a
   segment with no data is omitted, never rendered empty. #}
{% block shell_page_subtitle %}
    {%- set segments = [typeLabel|lower ~ ' patrol'] -%}
    {%- if patrol.lead %}{% set segments = segments|merge([ui.person_name(patrol.lead)|trim]) %}{% endif -%}
    {%- if patrol.team %}{% set segments = segments|merge(['+ ' ~ patrol.team]) %}{% endif -%}
    {%- if patrol.startedAt and patrol.endedAt -%}
        {%- set segments = segments|merge([patrol.startedAt|date('D j M')|lower ~ ' ' ~ patrol.startedAt|date('H:i') ~ '–' ~ patrol.endedAt|date('H:i')]) -%}
    {%- elseif patrol.startedAt -%}
        {%- set segments = segments|merge([patrol.startedAt|date('D j M')|lower ~ ' ' ~ patrol.startedAt|date('H:i')]) -%}
    {%- endif -%}
    {%- if patrol.distanceKm is not null %}{% set segments = segments|merge([patrol.distanceKm|number_format(1) ~ ' km']) %}{% endif -%}
    {%- if observations|length %}{% set segments = segments|merge([observations|length ~ (observations|length == 1 ? ' observation' : ' observations')]) %}{% endif -%}
    {{- segments|join(' · ') }}.
{% endblock %}

{% block shell_page_actions %}
    {# Only a RECORDED track can be exported; a sketched manual route must
       never be handed out as a .gpx, or it re-enters the world as a
       recording (docs/design-decisions.md §4). The action is absent, not
       disabled: there is no file here to be had later, so a greyed control
       would promise one. The route enforces the same rule (404). #}
    {% if patrol.hasRecordedTrack %}
        <a class="tgl patrol-act" href="{{ path('patrol_export_gpx', {uuid: area.uuid, patrol: patrol.uuid}) }}" download="{{ patrol.ref }}.gpx">{{ ux_icon('patrol:download') }}Export GPX</a>
    {% endif %}
{% endblock %}

{% block patrol_page %}
<a class="backbtn" href="{{ path('patrol_dashboard', {uuid: area.uuid}) }}">{{ ux_icon('shell:chevron-left') }}All patrols</a>

{# The discarded notice. Everything a reader needs in one block, in the order
   they ask it: that this patrol was thrown away, why, what happens to it next,
   and — for whoever may — the brake.

   Stated ONCE, above the record rather than beside every figure on it: the
   patrol is counted in nothing, and repeating "not counted" on each plate would
   make the page about the discard instead of about the patrol. #}
{% if patrol.discarded %}
    <div class="patrol-discard" role="note">
        <div class="patrol-discard-head">
            <span class="chip patrol-discard-pill">discarded</span>
            {% if patrol.held %}<span class="chip warn">held for review</span>{% endif %}
        </div>
        {# The ranger's own words. Required by the sync API, so there is always
           one — but rendered defensively, because a record that reached the
           table another way is not worth a broken page. #}
        <p class="patrol-discard-why">{{ patrol.discardReason ?: 'No reason was recorded.' }}</p>
        <p class="patrol-discard-fate">
            {%- if patrol.held -%}
                On hold{% if patrol.heldBy %} by {{ ui.person_name(patrol.heldBy) }}{% endif %}{% if patrol.heldAt %} since <time datetime="{{ patrol.heldAt|date('c') }}" data-localtime-format="date">{{ patrol.heldAt|date('j M Y')|lower }}</time>{% endif %}.
                The retention clock is stopped: this patrol is kept until the hold is released.
            {%- elseif purgeDueAt -%}
                Kept for {{ retentionDays }} days after it was discarded, then deleted with its
                photographs — on or after <time datetime="{{ purgeDueAt|date('c') }}" data-localtime-format="date">{{ purgeDueAt|date('j M Y')|lower }}</time>.
            {%- else -%}
                Kept for {{ retentionDays }} days after it was discarded, then deleted with its
                photographs. This patrol carries no date to measure from, so it is left in place.
            {%- endif -%}
        </p>
        {# The one write this screen has. Absent — not disabled — for a reader
           without "patrols.record", and absent entirely in a host with no
           security, where the route does not exist to post to. #}
        {% if holdToken %}
            <form class="patrol-discard-act" method="post" action="{{ path('patrol_hold', {uuid: area.uuid, patrol: patrol.uuid}) }}">
                <input type="hidden" name="_token" value="{{ holdToken }}">
                <input type="hidden" name="hold" value="{{ patrol.held ? '0' : '1' }}">
                <button type="submit" class="tgl patrol-act">
                    {%- if patrol.held -%}
                        {{ ux_icon('patrol:play') }}Release hold
                    {%- else -%}
                        {{ ux_icon('patrol:pause') }}Hold for review
                    {%- endif -%}
                </button>
            </form>
        {% endif %}
    </div>
{% endif %}

{# THE RECORD IS ONE GRID — the shell's own .recgrid, the same two columns for
   every row of every record page in the product. The plate card is first in the
   left column and the observations logged en route sit directly under the map;
   the patrol's own facts and its history run down the column beside them.

   A map is a fixed plate of imagery rather than a column of facts, so the column
   beside it is free to run past it, and the card under the map starts where the
   map ends. #}
<div class="recgrid">
    <div class="col">
        <div class="c patrol-plate patrol-plate-fill" data-patrol-track>
            <span class="tab">Track plate<span class="src">· {{ patrol.ref }} · satellite · live</span></span>
            <span class="lib">{{ patrol.source.value == 'gpx' ? 'gpx track' : (patrol.source.value == 'api' ? 'api track' : 'sketched route') }}</span>
            {{ ui.plate(
                map,
                'Patrol ' ~ patrol.ref ~ ' track',
                patrol.ref ~ ' · ' ~ (patrol.station ?: '—') ~ ' · ' ~ typeLabel|lower,
                'satellite · live · numbered markers = observations'
            ) }}
        </div>

        <div class="c" data-patrol-observations>
            <span class="tab">Observations<span class="src">· {{ observations|length }} · logged en route</span></span>
            {% for row in observations %}
                <div class="patrol-obs-r">
                    <span class="patrol-obs-n">{{ row.n }}</span>
                    <span class="patrol-obs-t">{% if row.observation.loggedAt %}<time datetime="{{ row.observation.loggedAt|date('c') }}" data-localtime-format="time">{{ row.observation.loggedAt|date('H:i') }}</time>{% else %}—{% endif %}</span>
                    <span class="patrol-obs-bd">
                        <span class="chip warn patrol-obs-chip">{{ ui.category_label(row.observation.category, categories) }}</span>{{ row.observation.note }}
                        {# The design's sub-line ends "· 2 photos". HELD photographs,
                           never the number the phone promised: this row is read as a
                           claim about what the patrol brought back. An observation
                           with none says nothing at all rather than "0 photos",
                           exactly as the design's rows do. #}
                        {% set rowPhotos = row.observation.photos|length %}
                        <em>{{ row.dms ?: 'no position recorded' }}{% if rowPhotos %} · {{ rowPhotos }} photo{{ rowPhotos == 1 ? '' : 's' }}{% endif %}</em>
                    </span>
                    <a class="open-btn patrol-obs-open" href="{{ path('patrol_observation_show', {uuid: area.uuid, patrol: patrol.uuid, observation: row.observation.uuid}) }}">Open →</a>
                </div>
            {% else %}
                <div class="patrol-obs-r patrol-obs-empty">
                    <span class="patrol-obs-bd">No observations were logged on this patrol.</span>
                </div>
            {% endfor %}
        </div>
    </div>

    <div class="col">
        {# The patrol's own history, in the settled discard design's D4 grammar:
           NEWEST FIRST, each entry a title with "time · actor · detail" beneath
           it, and nothing on it editable or removable. "The web shows the same
           story" — these are the very events the phone recorded, synced through
           §9A, not a second web-side log of them.

           Three sources, in the order a reader meets them:
             · the hold, where one stands — a web-side power the phone cannot
               raise, so it is derived from the columns it wrote rather than
               from an event;
             · every PatrolEvent, latest first;
             · the record's own beginning, which no event describes.

           STILL PARTIAL, and honestly so: imports, transcriptions and incident
           links are not events yet. What is rendered is what actually happened
           and is actually stored — never a placeholder for what is not. #}
        {# THE PATROL'S OWN FACTS (the settled design's PL·02), in a card above
           the history rather than in a band across the top. A band is for facts
           that never change; half of these are counts of what this patrol
           BROUGHT BACK, and they belong beside the story of it. A row with no
           value is omitted, never rendered empty. #}
        <div class="c" data-patrol-facts>
            <span class="tab">The patrol<span class="src">· what it was, and what it brought back</span></span>
            <div class="rln"><span>Type</span><span class="mono d">{{ typeLabel|lower }}</span></div>
            {% if patrol.station %}<div class="rln"><span>Station</span><span class="mono d">{{ patrol.station }}</span></div>{% endif %}
            <div class="rln"><span>Lead</span><span class="mono d">{{ ui.person_name(patrol.lead) }}</span></div>
            {% if patrol.team %}<div class="rln"><span>Team</span><span class="mono d">{{ patrol.team }}</span></div>{% endif %}
            {% if patrol.startedAt %}<div class="rln"><span>Started</span><span class="mono d">{{ ui.stamp(patrol.startedAt) }}</span></div>{% endif %}
            {% if patrol.endedAt %}<div class="rln"><span>Ended</span><span class="mono d">{{ ui.stamp(patrol.endedAt) }}</span></div>{% endif %}
            {% if patrol.startedAt and patrol.endedAt %}<div class="rln"><span>Duration</span><span class="mono d">{{ ui.duration(patrol) }}</span></div>{% endif %}
            {% if patrol.distanceKm is not null %}
                <div class="rln"><span>Distance</span><span class="mono d">{{ patrol.distanceKm|number_format(1) }} km{% if avgSpeedKmh is not null %} · {{ avgSpeedKmh|number_format(1) }} km/h{% endif %}</span></div>
            {% endif %}
            {# The design names each gap's length; this module counts gaps but
               does not store their durations, so the row states the count it
               actually has rather than a number it would have to invent. #}
            <div class="rln"><span>Gaps</span><span class="mono {{ patrol.gapCount ? 'w' : 'd' }}">{{ patrol.gapCount }}</span></div>
            <div class="rln"><span>Source</span><span class="mono d">
                {%- if patrol.source.value == 'gpx' -%}GPX import
                {%- elseif patrol.source.value == 'api' -%}handset sync
                {%- else -%}manual
                {%- endif -%}
            </span></div>
            {% if patrol.pointCount is not null %}<div class="rln"><span>GPS points</span><span class="mono d">{{ patrol.pointCount|number_format }}</span></div>{% endif %}
            <div class="rln"><span>Photos</span><span class="mono d">{{ photoCount }}</span></div>

            <div class="use" style="margin:12px 2px 2px">A gap is minutes with no fix, drawn broken on the plate and never smoothed over. <b>Source</b> is one of three — <span class="mono">handset sync</span>, <span class="mono">GPX import</span> or <span class="mono">manual</span> — and a manually logged patrol never claims a measured distance.</div>

            <div class="rln" style="margin-top:6px"><span>Observations</span><span class="mono d">{{ observations|length }}</span></div>
            {% for row in observations %}
                <div class="rln">
                    <span class="mono d">{{ row.n }} · {% if row.observation.loggedAt %}{{ row.observation.loggedAt|date('H:i') }}{% else %}—{% endif %} · {{ ui.category_label(row.observation.category, categories)|lower }}</span>
                    <a class="open-btn" href="{{ path('patrol_observation_show', {uuid: area.uuid, patrol: patrol.uuid, observation: row.observation.uuid}) }}">Open →</a>
                </div>
            {% endfor %}
        </div>

        <div class="c" data-patrol-history>
            <span class="tab">History<span class="src">· {{ patrol.events|length + (patrol.held ? 2 : 1) }} · append-only</span></span>

            {% if patrol.held %}
                <div class="rln patrol-hist-r">
                    <span class="d">{{ ui.log_stamp(patrol.heldAt) }}</span>
                    <span><b>Held for review</b><em>{% if patrol.heldBy %}{{ ui.person_name(patrol.heldBy) }} · {% endif %}purge stopped</em></span>
                </div>
            {% endif %}

            {# Reversed for the design's newest-first reading. The collection is
               stored oldest-first because that is the order the story happened
               in and the order the retention clock reads it; the reversal is a
               presentation choice and lives here. #}
            {% for event in patrol.events|reverse %}
                <div class="rln patrol-hist-r">
                    <span class="d">{{ ui.log_stamp(event.at) }}</span>
                    <span>
                        <b>{{ event.kind.label }}</b>
                        <em>
                            {%- if event.actor %}{{ ui.person_name(event.actor) }}{% else %}unattributed{% endif -%}
                            {%- if event.subject %} · {% if event.previous %}{{ event.previous }} → {% endif %}{{ event.subject }}{% endif -%}
                        </em>
                    </span>
                </div>
            {% endfor %}

            {# The one entry no event describes: how this record came to exist. #}
            <div class="rln patrol-hist-r">
                <span class="d">{{ ui.log_stamp(patrol.createdAt) }}</span>
                <span><b>{{ patrol.source.value == 'gpx' ? 'Track imported from GPX' : (patrol.source.value == 'api' ? 'Received through the ingest API' : 'Logged manually') }}</b></span>
            </div>
        </div>
    </div>
</div>
{% endblock %}
